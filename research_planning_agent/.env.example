# Quick start works without an LLM key using the built-in MOCK provider.
# Options: mock, ollama, openai, anthropic, google_genai
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TEMPERATURE=0.2

# Search options: duckduckgo, tavily, auto
# auto uses Tavily when TAVILY_API_KEY is set, otherwise DuckDuckGo.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# Provider keys (only the one matching LLM_PROVIDER is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama example: LLM_PROVIDER=ollama, LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

MAX_REFLECTION_LOOPS=2
MAX_RESEARCH_STEPS=5
REQUIRE_HUMAN_APPROVAL=false
